# ============================================================
# Telegram Moderatsiya Boti - Muhit O'zgaruvchilari (.env)
# ============================================================

# 1. Telegram Bot Token (@BotFather dan olingan token)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_12345678

# 2. Asosiy Adminlar Telegram ID'lari (vergul bilan bir nechta yozish mumkin)
ADMIN_IDS=123456789,987654321

# 3. Guruh ID si (Bot nazorat qiladigan Telegram guruh/superguruh)
# Guruh ID si odatda manfiy bo'ladi: masalan -100 bilan boshlanadi
GROUP_ID=-1001234567890

# 4. Maxfiy Log Kanal ID si (Barcha moderatsiya hisobotlari boradigan kanal)
LOG_CHANNEL_ID=-1009876543210

# 5. Discord Server havolasi (/discord buyrug'i uchun)
DISCORD_URL=https://discord.gg/yourserver

# 6. Captcha sozlamalari
# Yangi a'zoga tugmani bosish uchun beriladigan vaqt (soniyalarda)
CAPTCHA_TIMEOUT=90

# 7. Ogohlantirishlar (Warn) chegarasi
# 3 yoki 4 ta ogohlantirishdan so'ng avtomatik 24 soatga Mute qilinadi
MAX_WARNS=3

# 8. Chat tozaligi (Auto-delete)
# Bot javoblari va admin buyruqlari necha soniyadan so'ng o'chirilishi kerak
AUTO_DELETE_DELAY=20

# 9. Ma'lumotlar bazasi (Ixtiyoriy)
# Agar Supabase (PostgreSQL) ishlatmoqchi bo'lsangiz quyidagiga ulanish havolasini yozing:
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Agar bo'sh qoldirsangiz, bot avtomatik ravishda SQLite (moderation.db) da ishlaydi!
DATABASE_URL=

# 10. Render.com / Web server porti (Render avtomatik kiritadi, sukut bo'yicha: 8080)
PORT=8080
